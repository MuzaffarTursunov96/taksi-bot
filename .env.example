# BotFather'dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# OpenAI API kaliti (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Mos xabarlar yuboriladigan shofyor(lar)ning Telegram chat ID raqami(lari), vergul bilan ajratilgan
# Chat ID ni olish uchun @userinfobot ga /start yozing
DRIVER_CHAT_IDS=111111111,222222222

# Faqat telethon_listener.py (shaxsiy akkaunt orqali guruhlarni tinglash) uchun kerak
# https://my.telegram.org/apps dan olinadi
API_ID=12345678
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Faqat SIZ (egasi) /adddriver, /removedriver, /listdrivers buyruqlarini ishlata olishingiz uchun
OWNER_ID=111111111

# Ixtiyoriy: bot faqat shu guruhlarni tinglasin desangiz (vergul bilan ajratilgan chat_id'lar).
# Bo'sh qoldirsangiz — quyidagi GROUP_MODE=all bo'yicha barcha guruhlar tinglanadi.
MONITORED_GROUP_IDS=-1001756372109,-1001310037314

# "all" — barcha guruhlarni tinglaydi (default). "selected" — faqat MONITORED_GROUP_IDS
# (yoki /enablegroup orqali qo'shilganlarni) tinglaydi.
GROUP_MODE=selected
